# Top-level assets/ holds raw robot meshes (the build input for
# scripts/build_robot_description.py). Scoped with a leading slash so
# docs/assets/ (tracked documentation videos) isn't accidentally
# ignored.
# Use ``/dir/*`` rather than ``/dir/`` so the negations below can
# re-include selected children — git refuses to recurse into a fully
# excluded directory.
/assets/*
# Exception: ship the bimanual FR3 description so the build pipeline
# is runnable straight from a fresh clone.
!/assets/bimanual_fr3_description/
# Exception: ship environment scenes (pointclouds) so the demos/tests
# are runnable from a fresh clone.
!/assets/envs/
/assets/envs/*
!/assets/envs/rls_env/
/assets/envs/rls_env/*
!/assets/envs/rls_env/pcd/

# Generated FK headers (built by cricket, consumed by vamp).
# Hand-written headers in this project use .hpp instead, so they are
# never matched by this rule and stay tracked.
*.hh
# Exception: ship the per-robot FK/collision headers so downstream
# builds (manylinux wheels, fresh clones without cricket's deps) don't
# have to regenerate them. Regenerate via `pixi run generate-fk` when
# the spherized URDF or SRDF changes, then re-commit.
!ext/ompl_vamp/robot/bimanual_fr3.hh
!ext/ompl_vamp/robot/bimanual_fr3_soft.hh
!ext/ompl_vamp/robot/single_fr3.hh
!ext/ompl_vamp/robot/single_fr3_soft.hh

# Generated build artifacts
output.json

# pixi environments
.pixi/*
!.pixi/config.toml
